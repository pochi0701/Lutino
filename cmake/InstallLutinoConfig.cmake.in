set(_lutino_document_root "@LUTINO_DOCUMENT_ROOT@")
if(_lutino_document_root STREQUAL "")
  set(_lutino_document_root "${CMAKE_INSTALL_PREFIX}/html")
elseif(NOT IS_ABSOLUTE "${_lutino_document_root}")
  set(_lutino_document_root "${CMAKE_INSTALL_PREFIX}/${_lutino_document_root}")
endif()

set(_lutino_skin_root "@LUTINO_SKIN_ROOT@")
if(_lutino_skin_root STREQUAL "")
  set(_lutino_skin_root "${CMAKE_INSTALL_PREFIX}/skin")
elseif(NOT IS_ABSOLUTE "${_lutino_skin_root}")
  set(_lutino_skin_root "${CMAKE_INSTALL_PREFIX}/${_lutino_skin_root}")
endif()

set(_lutino_system_root "@LUTINO_SYSTEM_ROOT@")
if(_lutino_system_root STREQUAL "")
  set(_lutino_system_root "${CMAKE_INSTALL_PREFIX}/system")
elseif(NOT IS_ABSOLUTE "${_lutino_system_root}")
  set(_lutino_system_root "${CMAKE_INSTALL_PREFIX}/${_lutino_system_root}")
endif()

set(_lutino_database_root "@LUTINO_DATABASE_ROOT@")
if(_lutino_database_root STREQUAL "")
  set(_lutino_database_root "${CMAKE_INSTALL_PREFIX}/database")
elseif(NOT IS_ABSOLUTE "${_lutino_database_root}")
  set(_lutino_database_root "${CMAKE_INSTALL_PREFIX}/${_lutino_database_root}")
endif()

set(_lutino_work_root "@LUTINO_WORK_ROOT@")
if(_lutino_work_root STREQUAL "")
  set(_lutino_work_root "${CMAKE_INSTALL_PREFIX}/work")
elseif(NOT IS_ABSOLUTE "${_lutino_work_root}")
  set(_lutino_work_root "${CMAKE_INSTALL_PREFIX}/${_lutino_work_root}")
endif()

file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}")

set(_lutino_conf [=[
##
## Lutino parameter settings
##

server_port             8000
server_tls_port         8443

flag_debug_log_output   false

document_root ]=] "${_lutino_document_root}" [=[
skin_root               ]=] "${_lutino_skin_root}" [=[
skin_name               lutino
skin_menu               menu.jss

alias /html/system ]=] "${_lutino_system_root}" [=[

flag_execute_cgi        true
flag_allow_proxy        true
system_password
]=])

file(WRITE "${CMAKE_INSTALL_PREFIX}/ltn.conf" "${_lutino_conf}")

message(STATUS "Installed ltn.conf to ${CMAKE_INSTALL_PREFIX}/ltn.conf")
message(STATUS "  document_root = ${_lutino_document_root}")
message(STATUS "  skin_root     = ${_lutino_skin_root}")
message(STATUS "  system_root   = ${_lutino_system_root}")
message(STATUS "  database_root = ${_lutino_database_root}")
message(STATUS "  work_root     = ${_lutino_work_root}")
