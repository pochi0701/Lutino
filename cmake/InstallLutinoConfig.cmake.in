set(_lutino_install_dir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_lutino_conf_source "@CMAKE_CURRENT_SOURCE_DIR@/ltn.conf.linux")
set(_lutino_source_root "@CMAKE_CURRENT_SOURCE_DIR@")

if(NOT EXISTS "${_lutino_conf_source}")
  message(FATAL_ERROR "Error: ${_lutino_conf_source} was not found.")
endif()

foreach(_lutino_source_dir html database skin system)
  if(NOT IS_DIRECTORY "${_lutino_source_root}/${_lutino_source_dir}")
    message(FATAL_ERROR
      "Error: ${_lutino_source_root}/${_lutino_source_dir} was not found."
    )
  endif()
endforeach()

if(EXISTS "${_lutino_install_dir}")
  file(GLOB _lutino_existing_entries LIST_DIRECTORIES true
    "${_lutino_install_dir}/*"
  )
  if(_lutino_existing_entries)
    message(FATAL_ERROR
      "Warning: ${CMAKE_INSTALL_PREFIX} is not empty; installation aborted."
    )
  endif()
endif()

file(MAKE_DIRECTORY "${_lutino_install_dir}")

file(READ "${_lutino_conf_source}" _lutino_conf)
string(REGEX REPLACE
  "(^|\n)[ \t]*document_root[ \t]+[^\r\n]*"
  "\\1document_root           ${CMAKE_INSTALL_PREFIX}/html"
  _lutino_conf
  "${_lutino_conf}"
)
string(REGEX REPLACE
  "(^|\n)[ \t]*skin_root[ \t]+[^\r\n]*"
  "\\1skin_root               ${CMAKE_INSTALL_PREFIX}/skin"
  _lutino_conf
  "${_lutino_conf}"
)
file(WRITE "${_lutino_install_dir}/ltn.conf" "${_lutino_conf}")
